# Backend server
PORT=3001
DATABASE_PATH=./server/data/omega.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Google Form that users open after registering (also encoded in the QR code).
GOOGLE_FORM_URL=https://forms.gle/your-form-id

# Optional per-pass payment forms. Fall back to GOOGLE_FORM_URL when unset.
GOOGLE_FORM_URL_RAS=
GOOGLE_FORM_URL_IEEE=
GOOGLE_FORM_URL_NON_IEEE=

# Optional per-event + pass payment forms (highest priority).
GOOGLE_FORM_URL_LINE_FOLLOWER_RAS=
GOOGLE_FORM_URL_LINE_FOLLOWER_IEEE=
GOOGLE_FORM_URL_LINE_FOLLOWER_NON_IEEE=
GOOGLE_FORM_URL_MAZE_SOLVER_RAS=
GOOGLE_FORM_URL_MAZE_SOLVER_IEEE=
GOOGLE_FORM_URL_MAZE_SOLVER_NON_IEEE=

# Long random string. Used internally after a successful admin login.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Admin panel credentials for /admin
ADMIN_USERNAME=kz
ADMIN_PASSWORD=14032000
